# Copy to keystore.properties (gitignored) and fill in your own signing material.
# Alternatively export AERODESK_KEYSTORE / AERODESK_STORE_PASSWORD /
# AERODESK_KEY_ALIAS / AERODESK_KEY_PASSWORD in the environment.
# Without any of these, `assembleRelease` produces an unsigned APK.
storeFile=keystore/your.keystore
storePassword=
keyAlias=
keyPassword=
